# SPMS backend environment template.
# Copy to .env and fill in real values. NEVER commit .env.

# Django
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (mandatory engine — do not switch away from PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=spms
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Time (UTC storage; BUSINESS_TIMEZONE is used only for report day-bucketing)
BUSINESS_TIMEZONE=Asia/Kolkata

# CORS (local development)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False

# Reserved for later phases (do not enable yet)
# JWT_SIGNING_KEY=
# PAYMENT_GATEWAY_KEY=
